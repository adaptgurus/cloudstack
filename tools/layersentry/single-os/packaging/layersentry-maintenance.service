[Unit]
Description=LayerSentry Single-OS maintenance evaluation
After=network-online.target layersentry-privileged.service
Requires=layersentry-privileged.service

[Service]
Type=oneshot
User=layersentry
Group=layersentry
ExecStart=/usr/bin/layersentryd maintenance-run
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/layersentryd /run/layersentryd /etc/fstab /etc/nginx /var/lib/pgsql /var/log/nginx /srv /data /opt/layersentry-data /var/log/layersentry-services
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
AmbientCapabilities=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
