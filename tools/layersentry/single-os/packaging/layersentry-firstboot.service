[Unit]
Description=LayerSentry Single-OS clone-safe first boot
DefaultDependencies=no
After=local-fs.target systemd-tmpfiles-setup.service
Before=layersentryd.service
ConditionPathExists=!/var/lib/layersentryd/identity/node-id

[Service]
Type=oneshot
User=layersentry
Group=layersentry
ExecStart=/usr/bin/layersentryd firstboot
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/layersentryd

[Install]
WantedBy=multi-user.target
