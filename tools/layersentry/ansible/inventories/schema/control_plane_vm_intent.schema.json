{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://layersentry.example/schemas/control-plane-vm-intent-v1.json",
  "title": "LayerSentry Bootstrap Control-Plane VM Intent V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "role",
    "uuid",
    "failure_domain",
    "memory_mib",
    "vcpus",
    "machine",
    "firmware",
    "osinfo",
    "storage_pool",
    "base_volume",
    "base_image_sha256",
    "root_size_gib",
    "management_bridge",
    "management_mtu",
    "mac",
    "hostname",
    "ip_cidr",
    "gateway",
    "dns_servers",
    "ssh_authorized_keys"
  ],
  "properties": {
    "name": {
      "enum": [
        "LS-DB-01",
        "LS-DB-02",
        "LS-DB-03",
        "LS-MGMT-01",
        "LS-MGMT-02",
        "LS-MGMT-03",
        "LS-LB-01",
        "LS-LB-02"
      ]
    },
    "role": {
      "enum": [
        "db",
        "management",
        "lb"
      ]
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "failure_domain": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "memory_mib": {
      "type": "integer",
      "minimum": 1
    },
    "vcpus": {
      "type": "integer",
      "minimum": 1
    },
    "machine": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
    },
    "firmware": {
      "const": "uefi"
    },
    "osinfo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
    },
    "storage_pool": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "base_volume": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "base_image_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "root_size_gib": {
      "type": "integer",
      "minimum": 1
    },
    "management_bridge": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,62}$"
    },
    "management_mtu": {
      "type": "integer",
      "minimum": 1280,
      "maximum": 9216
    },
    "mac": {
      "type": "string",
      "pattern": "^52:54:([0-9A-Fa-f]{2}:){3}[0-9A-Fa-f]{2}$"
    },
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$"
    },
    "ip_cidr": {
      "type": "string",
      "pattern": "^[0-9]{1,3}(?:\\.[0-9]{1,3}){3}/(?:[0-9]|[12][0-9]|3[0-2])$"
    },
    "gateway": {
      "type": "string",
      "pattern": "^[0-9]{1,3}(?:\\.[0-9]{1,3}){3}$"
    },
    "dns_servers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]{1,3}(?:\\.[0-9]{1,3}){3}$"
      }
    },
    "ssh_authorized_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 20,
        "maxLength": 8192
      }
    },
    "readiness_timeout_seconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 900
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "role": {
            "const": "db"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "properties": {
          "name": {
            "enum": [
              "LS-DB-01",
              "LS-DB-02",
              "LS-DB-03"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "management"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "properties": {
          "name": {
            "enum": [
              "LS-MGMT-01",
              "LS-MGMT-02",
              "LS-MGMT-03"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "const": "lb"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "properties": {
          "name": {
            "enum": [
              "LS-LB-01",
              "LS-LB-02"
            ]
          }
        }
      }
    }
  ]
}
