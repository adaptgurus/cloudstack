[Unit]
Description=LayerSentry Kubernetes single-active reconciler
After=network-online.target
Wants=network-online.target
ConditionPathIsReadWrite=/var/lib/layersentry/k8s

[Service]
Type=oneshot
User=layersentry-k8s
Group=layersentry-k8s
UMask=0077
Environment=PYTHONPATH=/usr/lib/layersentry/k8s
ExecStart=/usr/bin/python3 /usr/lib/layersentry/k8s/layersentry_k8s_controller.py --config /etc/layersentry/k8s/runtime.json reconcile --max-operations 20
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/layersentry/k8s
ReadOnlyPaths=/etc/layersentry/k8s /run/credentials/layersentry-k8s

[Install]
WantedBy=multi-user.target
