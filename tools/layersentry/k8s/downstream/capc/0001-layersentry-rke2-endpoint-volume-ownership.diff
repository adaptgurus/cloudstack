+// recordDeployTimeDataDisk records the one DATADISK that CAPC requested as
+// part of VM deployment. The persisted status ID and CloudStack ownership tags
+// must both match before deletion can include the volume. This deliberately
+// fails closed if the result is ambiguous.
+func (c *client) recordDeployTimeDataDisk(csMachine *infrav1.CloudStackMachine) error {
+	if csMachine.Annotations[LayerSentryVolumeOwnershipAnnotation] != "true" {
+		return nil
+	}
+	if csMachine.Spec.DiskOffering.ID == "" && csMachine.Spec.DiskOffering.Name == "" {
+		return nil
+	}
+	p := c.cs.Volume.NewListVolumesParams()
+	p.SetVirtualmachineid(*csMachine.Spec.InstanceID)
+	p.SetType("DATADISK")
+	setIfNotEmpty(c.user.Project.ID, p.SetProjectid)
+	response, err := c.cs.Volume.ListVolumes(p)
+	if err != nil {
+		return errors.Wrap(err, "listing deploy-time data disk")
+	}
+	if response.Count != 1 {
+		return errors.Errorf("expected exactly one deploy-time data disk, found %d", response.Count)
+	}
+	volumeID := response.Volumes[0].Id
+	tags := map[string]string{
+		CreatedByCAPCTagName:              "1",
+		generateMachineTagName(csMachine): "1",
+	}
+	if err := c.AddTags(ResourceTypeVolume, volumeID, tags); err != nil {
+		return errors.Wrapf(err, "tagging deploy-time data disk %s", volumeID)
+	}
+	csMachine.Status.OwnedDataDiskID = volumeID
 	return nil
 }
 
