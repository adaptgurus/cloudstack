+package cloudinit
+
+import (
+	"crypto/sha256"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"sigs.k8s.io/yaml"
+)
+
+func TestAirgapChecksumCloudConfig(t *testing.T) {
+	for _, role := range []string{"init", "join", "worker"} {
+		t.Run(role, func(t *testing.T) {
+			data := []byte("synthetic checksum manifest\n")
+			expected := fmt.Sprintf("%x", sha256.Sum256(data))
+			input := BaseUserData{AirGapped: true, AirGappedChecksum: expected}
+			var rendered []byte
+			var err error
+			switch role {
+			case "init":
+				rendered, err = NewInitControlPlane(&ControlPlaneInput{BaseUserData: input})
+			case "join":
+				rendered, err = NewJoinControlPlane(&ControlPlaneInput{BaseUserData: input})
+			case "worker":
+				rendered, err = NewJoinWorker(&input)
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			var config struct {
+				RunCmd []string `json:"runcmd"`
+			}
+			if err = yaml.Unmarshal(rendered, &config); err != nil {
+				t.Fatalf("invalid cloud config: %v", err)
+			}
+			if len(config.RunCmd) == 0 {
+				t.Fatal("missing runcmd")
+			}
+			directory := t.TempDir()
+			path := filepath.Join(directory, "sha256sum-amd64.txt")
+			if err = os.WriteFile(path, data, 0600); err != nil {
+				t.Fatal(err)
+			}
+			check := strings.ReplaceAll(config.RunCmd[0], "/opt/rke2-artifacts", directory)
+			if !strings.Contains(check, expected) {
+				t.Fatal("checksum lost")
+			}
+			if err = exec.Command("sh", "-c", check).Run(); err != nil {
+				t.Fatal("valid checksum rejected", err)
+			}
+			if err = os.WriteFile(path, []byte("tampered"), 0600); err != nil {
+				t.Fatal(err)
+			}
+			if exec.Command("sh", "-c", check).Run() == nil {
+				t.Fatal("tampered checksum accepted")
+			}
+			if err = os.Remove(path); err != nil {
+				t.Fatal(err)
+			}
+			if exec.Command("sh", "-c", check).Run() == nil {
+				t.Fatal("missing checksum file accepted")
+			}
+		})
+	}
+}
