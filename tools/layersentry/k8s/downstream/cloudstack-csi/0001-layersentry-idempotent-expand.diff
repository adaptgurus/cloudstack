+func TestControllerExpandVolumeIsIdempotent(t *testing.T) {
+	ctx := context.Background()
+	connector := fake.New()
+	volumeID, err := connector.CreateVolume(ctx, "offering-1", "zone-1", "idempotent-volume", 5)
+	if err != nil {
+		t.Fatalf("CreateVolume failed: %v", err)
+	}
+	server := NewControllerServer(connector)
+	req := &csi.ControllerExpandVolumeRequest{
+		VolumeId: volumeID,
+		CapacityRange: &csi.CapacityRange{
+			RequiredBytes: util.GigaBytesToBytes(2),
+		},
+		VolumeCapability: &csi.VolumeCapability{
+			AccessType: &csi.VolumeCapability_Mount{Mount: &csi.VolumeCapability_MountVolume{}},
+		},
+	}
+
+	response, err := server.ControllerExpandVolume(ctx, req)
+	if err != nil {
+		t.Fatalf("ControllerExpandVolume failed: %v", err)
+	}
+	if response.CapacityBytes != util.GigaBytesToBytes(5) {
+		t.Fatalf("expected observed capacity, got %d", response.CapacityBytes)
+	}
+	if !response.NodeExpansionRequired {
+		t.Fatal("filesystem volume must preserve node expansion requirement")
+	}
+}
