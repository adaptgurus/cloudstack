{
  "apiBase": "/client/api",
  "servers": [
    {
      "name": "Local-Server",
      "apiHost": "",
      "apiBase": "/client/api"
    }
  ],
  "docBase": "https://docs.cloudstack.apache.org/en/4.22.1.1",
  "appTitle": "Layersentry",
  "footer": "Layersentry &middot; Apache CloudStack is licensed under the <a href='https://www.apache.org/licenses/LICENSE-2.0' target='_blank' rel='noopener noreferrer'>Apache License, Version 2.0</a>.",
  "loginTitle": "Layersentry",
  "loginFavicon": "assets/layersentry-icon.svg",
  "loginFooter": "Secure cloud infrastructure management.",
  "resetPasswordFooter": "",
  "logo": "assets/layersentry-logo.svg",
  "minilogo": "assets/layersentry-icon.svg",
  "banner": "assets/layersentry-logo.svg",
  "favicon": "assets/layersentry-icon.svg",
  "error": {
    "403": "assets/403.png",
    "404": "assets/404.png",
    "500": "assets/500.png"
  },
  "theme": {
    "@layout-mode": "light",
    "@logo-background-color": "#ffffff",
    "@mini-logo-background-color": "#ffffff",
    "@navigation-background-color": "#071536",
    "@project-nav-background-color": "#071536",
    "@project-nav-text-color": "rgba(255, 255, 255, 0.82)",
    "@navigation-text-color": "rgba(255, 255, 255, 0.82)",
    "@primary-color": "#1849b5",
    "@link-color": "#1849b5",
    "@link-hover-color": "#123a91",
    "@loading-color": "#1849b5",
    "@processing-color": "#1849b5",
    "@success-color": "#14804a",
    "@warning-color": "#b54708",
    "@error-color": "#b42318",
    "@font-size-base": "14px",
    "@heading-color": "#101828",
    "@text-color": "#344054",
    "@text-color-secondary": "#667085",
    "@disabled-color": "#98a2b3",
    "@border-color-base": "#d0d5dd",
    "@border-radius-base": "6px",
    "@box-shadow-base": "0 1px 3px rgba(16, 24, 40, 0.10)",
    "@logo-width": "192px",
    "@logo-height": "64px",
    "@mini-logo-width": "44px",
    "@mini-logo-height": "52px",
    "@banner-width": "300px",
    "@banner-height": "100px",
    "@error-width": "256px",
    "@error-height": "256px"
  },
  "keyboardOptions": {
    "us": "label.standard.us.keyboard",
    "uk": "label.uk.keyboard",
    "fr": "label.french.azerty.keyboard",
    "jp": "label.japanese.keyboard",
    "sc": "label.simplified.chinese.keyboard",
    "es-latam": "Spanish Latin American Keyboard"
  },
  "userCard": {
    "enabled": true,
    "title": "label.help",
    "icon": "question-circle-outlined",
    "links": [
      {
        "title": "Documentation",
        "text": "Apache CloudStack 4.22.1.1 documentation",
        "link": "https://docs.cloudstack.apache.org/en/4.22.1.1/",
        "icon": "read-outlined"
      },
      {
        "title": "API Documentation",
        "text": "Refer to Apache CloudStack API documentation",
        "link": "https://cloudstack.apache.org/api.html",
        "icon": "api-outlined"
      },
      {
        "title": "Community Support",
        "text": "Join the Apache CloudStack users mailing list",
        "link": "mailto:users-subscribe@cloudstack.apache.org",
        "icon": "mail-outlined"
      },
      {
        "title": "Report Upstream Issue",
        "text": "Submit an Apache CloudStack bug or improvement request",
        "link": "https://github.com/apache/cloudstack/issues/new",
        "icon": "bug-outlined"
      }
    ]
  },
  "plugins": [],
  "apidocs": true,
  "basicZoneEnabled": true,
  "multipleServer": false,
  "allowSettingTheme": true,
  "displayProjectFieldOnLogin": false,
  "imageSelectionInterface": "modern",
  "showUserCategoryForModernImageSelection": true,
  "showAllCategoryForModernImageSelection": false,
  "docHelpMappings": {},
  "notifyLatestCSVersion": true,
  "showSearchFilters": true,
  "announcementBanner": {
    "enabled": false,
    "showIcon": false,
    "closable": true,
    "persistDismissal": true,
    "type": "info",
    "message": "<strong>Service announcement</strong>",
    "startDate": "2025-06-01T00:00:00Z",
    "endDate": "2025-07-16T00:00:00Z"
  }
}
